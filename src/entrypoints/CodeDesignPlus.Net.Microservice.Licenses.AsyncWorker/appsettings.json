{
  "Hangfire": {
    "Prefix": "{hangfire:ms-licenses}:"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000",
        "Protocols": "Http1"
      }
    }
  },
  "Core": {
    "AppName": "ms-licenses",
    "TypeEntryPoint": "worker",
    "Version": "v1",
    "Description": "Microservice to manage the licenses",
    "Business": "CodeDesignPlus",
    "Contact": {
      "Name": "CodeDesignPlus",
      "Email": "support@codedesignplus.com"
    }
  },
  "Security": {
    "ClientId": "a74cb192-598c-4757-95ae-b315793bbbca",
    "IncludeErrorDetails": true,
    "ValidateAudience": true,
    "ValidateIssuer": true,
    "ValidateLifetime": true,
    "RequireHttpsMetadata": true,
    "ValidIssuer": "",
    "ValidAudiences": [
      "a74cb192-598c-4757-95ae-b315793bbbca"
    ],
    "Applications": []
  },
  "Redis": {
    "Instances": {
      "Core": {
        "ConnectionString": "localhost:6379"
      }
    }
  },
  "RedisCache": {
    "Enable": true,
    "Expiration": "00:05:00"
  },
  "RabbitMQ": {
    "Enable": false,
    "Host": "localhost",
    "Port": 5672,
    "UserName": "admin",
    "Password": "password",
    "EnableDiagnostic": true,
    "UseQueue": false
  },
  "ServiceBus": {
    "Enable": true,
    "UseQueue": false,
    "EnableDiagnostic": true
  },
  "Mongo": {
    "Enable": true,
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "db-ms-licenses",
    "Diagnostic": {
      "Enable": false,
      "EnableCommandText": false
    }
  },
  "Logger": {
    "Enable": true,
    "OTelEndpoint": "http://127.0.0.1:4317"
  },
  "Observability": {
    "Enable": true,
    "ServerOtel": "http://localhost:4317",
    "Trace": {
      "Enable": true,
      "AspNetCore": true,
      "GrpcClient": true,
      "SqlClient": false,
      "CodeDesignPlusSdk": true,
      "Redis": false,
      "Kafka": false,
      "RabbitMQ": true
    },
    "Metrics": {
      "Enable": true,
      "AspNetCore": true
    }
  },
  "Vault": {
    "Enable": true,
    "Address": "http://localhost:8200",
    "AppName": "ms-licenses",
    "Solution": "security-codedesignplus",
    "Token": "root",
    "Mongo": {
      "Enable": true,
      "TemplateConnectionString": "mongodb://{0}:{1}@localhost:27017"
    },
    "RabbitMQ": {
      "Enable": true
    }
  },
  "FileStorage": {
    "UriDownload": "http://localhost:5000/api/v1/filestorage/download",
    "Local": {
      "Enable": false,
      "Folder": "path/to/local/storage"
    },
    "AzureFile": {
      "Enable": false,
      "DefaultEndpointsProtocol": "https",
      "AccountName": "",
      "AccountKey": "",
      "EndpointSuffix": "core.windows.net"
    },
    "AzureBlob": {
      "Enable": true,
      "DefaultEndpointsProtocol": "https",
      "AccountName": "",
      "AccountKey": "",
      "EndpointSuffix": "core.windows.net"
    }
  },
  "GrpcClients": {
    "Payment": "http://ms-payments-grpc.kappali.svc.cluster.local:5001",
    "User": "http://ms-users-grpc.kappali.svc.cluster.local:5001",
