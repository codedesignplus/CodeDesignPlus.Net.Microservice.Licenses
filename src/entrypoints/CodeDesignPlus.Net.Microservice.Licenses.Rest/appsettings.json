{
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000",
        "Protocols": "Http1AndHttp2"
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 1000,
      "MaxConcurrentUpgradedConnections": 1000,
      "Http2": {
        "MaxStreamsPerConnection": 100,
        "InitialConnectionWindowSize": 131072,
        "InitialStreamWindowSize": 98304
      }
    }
  },
  "Core": {
    "Id": "66d33ea5-cbc6-4c9d-8b8b-6b55ab44cbc0",
    "PathBase": "/ms-licenses",
    "AppName": "ms-licenses",
    "TypeEntryPoint": "rest",
    "Version": "v1",
    "Description": "Microservice to manage the licenses",
    "Business": "CodeDesignPlus",
    "Contact": {
      "Name": "CodeDesignPlus",
      "Email": "support@codedesignplus.com"
    }
  },
  "Resources": {
    "Enable": true,
    "Server": "http://localhost:5001"
  },
  "Security": {
    "IncludeErrorDetails": true,
    "ValidateAudience": true,
    "ValidateIssuer": true,
    "ValidateLifetime": true,
    "RequireHttpsMetadata": true,
    "ValidIssuer": "",
    "ValidAudiences": [],
    "Applications": [],
    "ValidateLicense": false,
    "ValidateRbac": false,
    "ServerRbac": "http://localhost:5001",
    "RefreshRbacInterval": 10
  },
  "Redis": {
    "Instances": {
      "Core": {
        "ConnectionString": "localhost:6379"
      }
    }
  },
  "RedisCache": {
    "Enable": true,
    "Expiration": "00:05:00"
  },
  "RabbitMQ": {
    "Enable": false,
    "UseQueue": false,
    "Host": "localhost",
    "Port": 5672,
    "UserName": "user",
    "Password": "pass",
    "EnableDiagnostic": true
  },
  "ServiceBus": {
    "Enable": true,
    "UseQueue": false,
    "EnableDiagnostic": true
  },
  "Mongo": {
    "Enable": true,
    "Database": "db-ms-licenses",
    "Diagnostic": {
      "Enable": false,
      "EnableCommandText": false
    }
  },
  "Logger": {
    "Enable": true,
    "OTelEndpoint": "http://localhost:4317",
    "Level": "Warning"
  },
  "Observability": {
    "Enable": true,
    "ServerOtel": "http://localhost:4317",
    "Trace": {
      "Enable": true,
      "AspNetCore": true,
      "GrpcClient": true,
      "SqlClient": false,
      "CodeDesignPlusSdk": true,
      "Redis": true,
      "Kafka": false,
      "RabbitMQ": true
    },
    "Metrics": {
      "Enable": true,
      "AspNetCore": true
    }
  },
  "Vault": {
    "Enable": true,
    "Address": "http://localhost:8200",
    "AppName": "ms-licenses",
    "Solution": "security-codedesignplus",
    "Token": "root",
    "Mongo": {
      "Enable": true,
      "TemplateConnectionString": "mongodb://{0}:{1}@localhost:27017"
    },
    "RabbitMQ": {
      "Enable": true
    }
  },
  "GrpcClients": {
    "Payment": "http://ms-payments-grpc.kappali.svc.cluster.local:5001",
    "User": "http://ms-users-grpc.kappali.svc.cluster.local:5001",
    "Tenant": "http://ms-tenants-grpc.kappali.svc.cluster.local:5001",
    "Notification": "http://ms-notification-grpc.kappali.svc.cluster.local:5001",
    "Location": "http://ms-locations-grpc.kappali.svc.cluster.local:5001",
    "Email": "http://ms-emails-grpc.kappali.svc.cluster.local:5001",
    "FileStorage": "http://ms-filestorage-grpc.kappali.svc.cluster.local:5001",
    "ElectronicInvoicing": "http://ms-electronicinvoicing-grpc.kappali.svc.cluster.local:5001"
  },
  "FileStorage": {
    "UriDownload": "http://localhost:5000/api/v1/filestorage/download",
    "Local": {
      "Enable": false,
      "Folder": "path/to/local/storage"
    },
    "AzureFile": {
      "Enable": false,
      "DefaultEndpointsProtocol": "https",
      "AccountName": "",
      "AccountKey": "",
      "EndpointSuffix": "core.windows.net"
    },
    "AzureBlob": {
      "Enable": true,
      "DefaultEndpointsProtocol": "https",
      "AccountName": "",
      "AccountKey": "",
      "EndpointSuffix": "core.windows.net"
    }
  },
  "OnlinePayment": {
    "ReturnUrl": "https://www.kappali.com/purchase/payment-return",
    "SubscriptionReturnUrl": "https://www.kappali.com/apps/settings/organization/payment-return"
  },
  "Subscription": {
    "ReminderDays": [30, 15, 7, 1],
    "NoticeCatchUpDays": 3
  },
  "PlatformInvoicing": {
    "Enable": true,
    "ReferencePrefix": "license-order",
    "BuyerPersonTypeCode": "1",
    "BuyerTaxLiabilityCode": "ZZ",
    "BuyerTaxResponsibilities": [ "R-99-PN" ],
    "IdentificationTypeCodes": {
      "NIT": "31",
      "CC": "13",
      "CE": "22",
      "TI": "12",
      "RC": "11",
      "PP": "41"
    },
    "PaymentFormCode": "1",
    "PaymentMeansCodes": {
      "PSE": "47",
      "BANCOLOMBIA_TRANSFER": "47",
      "NEQUI": "47",
      "DAVIPLATA": "47"
    },
    "CardPaymentMethodType": "CARD",
    "CardPaymentMeansCodes": {
      "CREDIT": "48",
      "DEBIT": "49"
    },
    "UnknownPaymentMeansCode": "1",
    "FullyPrepaidPaymentMeansCode": "ZZZ",
    "UnitCode": "94",
    "VatTaxCode": "01",
    "VatTaxName": "IVA",
    "CreditNoteCorrectionConceptCode": "1",
    "EmailWaitForInvoice": "00:30:00",
    "FilesContainer": "00000000-f11e-0000-0000-000000000001"
  }
}
