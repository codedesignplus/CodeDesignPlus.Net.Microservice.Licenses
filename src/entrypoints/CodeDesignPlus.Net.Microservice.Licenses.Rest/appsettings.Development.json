{
  "Core": {
    "PathBase": ""
  },
  "Resources": {
    "Enable": false,
    "Server": "http://localhost:5001"
  },
  "Vault": {
    "Enable": true,
    "Address": "http://vault-active.vault.svc.cluster.local:8200",
    "AppName": "ms-licenses",
    "Solution": "kappali",
    "Token": "root",
    "Mongo": {
      "Enable": false,
      "TemplateConnectionString": "mongodb://{0}:{1}@localhost:27017"
    },
    "RabbitMQ": {
      "Enable": false
    }
  },
  "FileStorage": {
    "UriDownload": "https://services.kappali.com/api/FileStorage/Download",
    "Local": {
      "Enable": false,
      "Folder": "path/to/local/storage"
    },
    "AzureFile": {
      "Enable": false,
      "DefaultEndpointsProtocol": "https",
      "AccountName": "",
      "AccountKey": "",
      "EndpointSuffix": "core.windows.net"
    },
    "AzureBlob": {
      "Enable": true,
      "DefaultEndpointsProtocol": "https",
      "AccountName": "",
      "AccountKey": "",
      "EndpointSuffix": "core.windows.net"
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 1000,
      "MaxConcurrentUpgradedConnections": 1000,
      "Http2": {
        "MaxStreamsPerConnection": 100,
        "InitialConnectionWindowSize": 131072,
        "InitialStreamWindowSize": 98304
      }
    }
  },
  "RabbitMQ": {
    "Enable": true
  },
  "ServiceBus": {
    "Enable": false
  }
}
